/tests/
/dev/
node_modules
speed_tests/
.env
@charset
/.idea/
*.tgz
/browser-dev/

CLAUDE.md


# Large ephemeral outputs from bench/jit_inspection.js
/bench/jit_asm_dump.txt
/bench/jit_asm_core_dump.txt
/bench/turbo-*.json
/jit_trace.txt
/jit_asm.txt

# Vendored lcms2 C source (downloaded by bench/lcms_c/fetch-lcms2.sh).
# We commit the bench glue (bench_lcms.c / Makefile / README / fetch
# scripts) but NOT the third-party lcms2 source tree — too big, has
# its own upstream.
/bench/lcms_c/lcms2-2.18/
/bench/lcms_c/lcms2-2.19/
/bench/lcms_c/lcms2-*/
/bench/lcms_c/*.o
/bench/lcms_c/bench_lcms
/bench/lcms_c/bench_lcms.exe
/bench/lcms_c/bench_content_matrix
/bench/lcms_c/bench_content_matrix.exe

# lcms_compat/ harness — profiles are licensed artefacts (Adobe,
# IDEAlliance, ECI, RISO, etc.) so user-supplied copies stay local;
# reference .it8 data is derived measurement data and IS committed.
# See bench/lcms_compat/profiles/README.md for the licensing split.
/bench/lcms_compat/profiles/*
!/bench/lcms_compat/profiles/README.md

# Scratch / work-in-progress instrumented lcms2 tree — will be
# distilled down to a patch file under bench/lcms_compat/lcms_patch/
# in v1.5 (deferred from v1.3 to keep the release scoped), at which
# point this whole folder goes away.
/bench/lcms_exposed/
.claude/

# Private work-in-progress — not ready for public repo
/_wip/
/__wip/
.cursor/

# Old browser bundles, pulled by `npm run archive` — build artefacts, not source.
bench/archive/

# Superseded one-off benches and the large ephemeral asm dumps. Kept locally
# because they are occasionally worth re-reading, out of the repo because
# nothing references them and two of them are 16 MB of generated text.
bench/_archive/

# Decoded photo corpus — ~27 MB of derived .rgb.bin/.cmyk.bin planes.
# The SOURCE images in bench/release_matrix/images/ ARE committed (Unsplash
# licence, see their CREDITS.md) so the published comparison is reproducible;
# only the generated planes are ignored. Rebuild them with:
#   node bench/release_matrix/make_corpus.cjs
bench/release_matrix/corpus/
bench/release_matrix/node_modules/

# Reproduction runs from bench/reproduce.js — raw timing output, machine-specific.
# Curated result summaries (e.g. bench/results/v1.5.0-dev.md) stay tracked.
bench/results/[0-9]*/

# Bench runs (bench/results/<timestamp>/) stay ignored — raw, machine-specific,
# and superseded by the next run. Two things are NOT ignored and must stay
# tracked, because a control that lives on one disk is not a control:
#
#   bench/baseline/<machine>/   the pinned reference every refactor is gated
#                              against (scripts/bench_compare.js). Per machine:
#                              a Ryzen pin is not a control for an M2.
#   bench/history/<version>/<machine>/
#                              frozen per-release measurements, so a figure
#                              published in 1.5.5 can still be re-derived in 1.9.
#
# ~120 KB each. See bench/baseline/README.md.

# Licensed ICC profiles — same rule as bench/lcms_compat/profiles/ above.
# testbed/profiles/README.md says so of itself: ICC profiles are licensed
# artefacts and most of what ships in a real prepress workflow cannot be
# redistributed on a public repo. Supply your own licensed copies locally.
# The READMEs that say WHICH profiles the harness expects stay tracked.
/testbed/profiles/*
!/testbed/profiles/README.md

# Loose reproduce/pool logs and one-off dumps beside the timestamped runs.
/bench/results/*.log
/bench/results/multicore_matrix*.json
/bench/results/multicore_scaling*.json
